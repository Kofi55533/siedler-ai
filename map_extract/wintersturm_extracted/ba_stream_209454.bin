BanditArmy = {}

function OnGameStart()
    --Simis Waypointarmy Init

    StartSimpleJob("WaypointsFunc")
    
    --Holzstapel
    for i=1,8 do
        CreateWoodPile( "wood"..i, 15000 )
    end

    --Fixes
    FixStadtwache()
    HealSerfAndCannonFix()
    CalvaryFormationSelection()

    --HandelBalancing
	Trigger.RequestTrigger(Events.LOGIC_EVENT_GOODS_TRADED,nil,"TransactionDetails",1,nil,nil) 

    StartSimpleJob("VictoryJob")

    for i = 1,4 do
        ForbidTechnology(Technologies.T_MakeSnow,i)
    end
end

function OnPeacetimeOver()
    for i = 1,4 do
        SetHostile(i,5)
    end
    BanditArmy.CreateBanditCampArmies()
    for n = 1,24 do
        DestroyEntity("p"..n)
    end
    for m = 1,8 do
        ReplaceEntity("gate"..m,Entities.XD_PalisadeGate2)
    end
    AddPeriodicWinter(120*60)
    for i = 1,4 do
        AllowTechnology(Technologies.T_MakeSnow,i)
    end
end

function BanditArmy.CreateBanditCampArmies()
    for i = 1,2 do 
        BanditArmy["Army"..i] = {}
        BanditArmy["Army"..i] = DefensiveArmy.new(5, GetPosition("camp"..i.."_spawn").X, GetPosition("camp"..i.."_spawn").Y, 5000, PlayerChunk_GetPlayerEnemyChunk(5), 600, true,"Army"..i);
		DefensiveArmy.AddTroopSpawn(BanditArmy["Army"..i], 180, Entities.CU_BanditLeaderSword1, 8, GetPosition("camp"..i.."_spawn2").X, GetPosition("camp"..i.."_spawn2").Y, 0, math.random(1, 4));
		DefensiveArmy.AddTroopSpawn(BanditArmy["Army"..i], 180, Entities.CU_BanditLeaderSword1, 8, GetPosition("camp"..i.."_spawn2").X, GetPosition("camp"..i.."_spawn2").Y, 0, math.random(1, 4));
		DefensiveArmy.AddTroopSpawn(BanditArmy["Army"..i], 180, Entities.CU_BanditLeaderSword1, 8, GetPosition("camp"..i.."_spawn2").X, GetPosition("camp"..i.."_spawn2").Y, 0, math.random(1, 4));
		DefensiveArmy.AddTroopSpawn(BanditArmy["Army"..i], 180, Entities.CU_BanditLeaderBow1, 4, GetPosition("camp"..i.."_spawn2").X, GetPosition("camp"..i.."_spawn2").Y, 0, math.random(1, 4));
		DefensiveArmy.AddTroopSpawn(BanditArmy["Army"..i], 180, Entities.CU_BanditLeaderBow1, 4, GetPosition("camp"..i.."_spawn2").X, GetPosition("camp"..i.."_spawn2").Y, 0, math.random(1, 4));
		DefensiveArmy.AddTroopSpawn(BanditArmy["Army"..i], 180, Entities.CU_BanditLeaderBow1, 4, GetPosition("camp"..i.."_spawn2").X, GetPosition("camp"..i.."_spawn2").Y, 0, math.random(1, 4));
    end
    StartSimpleJob("StopBandit1")
    StartSimpleJob("StopBandit2")
end

function StopBandit1()
    if IsDestroyed("camp1") then
        DefensiveArmy.StopRespawn(BanditArmy["Army1"])
        return true;
    end
end

function StopBandit2()
    if IsDestroyed("camp2") then
        DefensiveArmy.StopRespawn(BanditArmy["Army2"])
        return true;
    end
end

--Aufrufe nach Ablauf des EMS-Timers

EMSGameStartAdditional = EMSGameStartAdditional or EMS.StartGame
function EMS.StartGame()
    EMSGameStartAdditional()
    Camera_ZoomSetFactorMaxBackup(2)
end
----------------------------------------------------Utilities--------------------------------------------------------------------


function VictoryJob()
    if IsDestroyed("hq1") and IsDestroyed("hq2") then
        Logic.PlayerSetGameStateToWon(3)
        Logic.PlayerSetGameStateToWon(4)
        Logic.PlayerSetGameStateToLost(1)
        Logic.PlayerSetGameStateToLost(2)
        Message("@color:229,190,1 Team 2 @color:255,255,255 gewinnt die Partie! Herzlichen Glückwunsch!")
        return true
    elseif IsDestroyed("hq3") and IsDestroyed("hq4") then
        Logic.PlayerSetGameStateToWon(1)
        Logic.PlayerSetGameStateToWon(2)
        Logic.PlayerSetGameStateToLost(3)
        Logic.PlayerSetGameStateToLost(4)
        Message("@color:229,190,1 Team 1 @color:255,255,255 gewinnt die Partie! Herzlichen Glückwunsch!")
        return true
    end
end

function FixStadtwache()
    GameCallback_OnTechnologyResearchedOriginal = GameCallback_OnTechnologyResearchedOriginal or GameCallback_OnTechnologyResearched
    function GameCallback_OnTechnologyResearched( _PlayerID, _TechnologyType )
        GameCallback_OnTechnologyResearchedOriginal( _PlayerID,_TechnologyType)
        if _TechnologyType == Technologies.T_TownGuard then
        Logic.SetTechnologyState(_PlayerID,Technologies.T_CityGuard, 3)
        end
    end
 end
--------------------------------------WoodPiles--------------------------------------------------

function CreateWoodPile( _posEntity, _resources )
    assert( type( _posEntity ) == "string" )
    assert( type( _resources ) == "number" )
    gvWoodPiles = gvWoodPiles or {
        JobID = Trigger.RequestTrigger(Events.LOGIC_EVENT_EVERY_SECOND,nil,"ControlWoodPiles",0,nil,nil),
    }
    local pos = GetPosition( _posEntity )
    local pile_id = Logic.CreateEntity( Entities.XD_Rock3, pos.X, pos.Y, 0, 0 )

    SetEntityName( pile_id, _posEntity.."_WoodPile" )

    local newE = ReplaceEntity( _posEntity, Entities.XD_ResourceTree )
    Logic.SetModelAndAnimSet(newE, Models.XD_SignalFire1)
    Logic.SetResourceDoodadGoodAmount( GetEntityId( _posEntity ), _resources*10 )
    Logic.SetModelAndAnimSet(pile_id, Models.Effects_XF_ChopTree)
    table.insert( gvWoodPiles, { ResourceEntity = _posEntity, PileEntity = _posEntity.."_WoodPile", ResourceLimit = _resources*9 } )
end

function ControlWoodPiles()
    for i = table.getn( gvWoodPiles ),1,-1 do
        if Logic.GetResourceDoodadGoodAmount( GetEntityId( gvWoodPiles[i].ResourceEntity ) ) <= gvWoodPiles[i].ResourceLimit then
            DestroyWoodPile( gvWoodPiles[i], i )
        end
    end
end

function DestroyWoodPile( _piletable, _index )
    local pos = GetPosition( _piletable.ResourceEntity )
    DestroyEntity( _piletable.ResourceEntity )
    DestroyEntity( _piletable.PileEntity )
    Logic.CreateEffect( GGL_Effects.FXCrushBuilding, pos.X, pos.Y, 0 )
    table.remove( gvWoodPiles, _index )
end
---------------------------------------------------------------------------------------------------------------------------------------

function CreateMilitaryGroup(_player,_entity,_soldiers,_position,_name,_lookAt)

	local id = Tools.CreateGroup(_player, _entity, _soldiers, _position.X, _position.Y,0)
	
	if _name ~= nil then
		SetEntityName(id,_name)
	end
	
	if _lookAt ~= nil then
		LookAt(id,_lookAt)
	end

    return id
end

